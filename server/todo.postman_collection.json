{
	"info": {
		"name": "React ToDo API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Get All Todos",
			"request": {
				"method": "GET",
				"url": {
					"raw": "http://localhost:3000/api/v1/todos",
					"protocol": "http",
					"host": ["localhost"],
					"port": "3000",
					"path": ["api", "v1", "todos"]
				}
			}
		},
		{
			"name": "Get Single Todo",
			"request": {
				"method": "GET",
				"url": {
					"raw": "http://localhost:3000/api/v1/todos/:id",
					"protocol": "http",
					"host": ["localhost"],
					"port": "3000",
					"path": ["api", "v1", "todos", ":id"]
				}
			}
		},
		{
			"name": "Create Todo",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"title\": \"Test Todo\",\n  \"isCompleted\": false\n}"
				},
				"url": {
					"raw": "http://localhost:3000/api/v1/todos",
					"protocol": "http",
					"host": ["localhost"],
					"port": "3000",
					"path": ["api", "v1", "todos"]
				}
			}
		},
		{
			"name": "Update Todo",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"title\": \"Updated Todo\",\n  \"isCompleted\": true\n}"
				},
				"url": {
					"raw": "http://localhost:3000/api/v1/todos/:id",
					"protocol": "http",
					"host": ["localhost"],
					"port": "3000",
					"path": ["api", "v1", "todos", ":id"]
				}
			}
		},
		{
			"name": "Delete Todo",
			"request": {
				"method": "DELETE",
				"url": {
					"raw": "http://localhost:3000/api/v1/todos/:id",
					"protocol": "http",
					"host": ["localhost"],
					"port": "3000",
					"path": ["api", "v1", "todos", ":id"]
				}
			}
		}
	]
}
